# CivicOps Spring Boot Backend Environment Template
# Copy to backend/.env or export before starting the backend locally
PORT=8080
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=civicops_db
SQL_USER=civicops_user
SQL_PASSWORD=civicops_password

# Required 32+ character cryptographically random secret for HS256 JWT signing
# Generate one in PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=change_me_to_a_strong_64_byte_random_secret_for_local_dev_only
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
