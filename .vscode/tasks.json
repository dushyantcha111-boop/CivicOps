{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "label": "Frontend: Start Vite Dev Server",
      "problemMatcher": ["$tsc"],
      "group": "none"
    },
    {
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "label": "Backend: Start Spring Boot",
      "problemMatcher": [],
      "group": "none"
    },
    {
      "type": "shell",
      "command": "docker compose up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "label": "Database: Start PostgreSQL (Docker)",
      "problemMatcher": [],
      "group": "none"
    }
  ]
}
